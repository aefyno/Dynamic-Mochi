<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DynamicMochi</AssemblyName>
    <RootNamespace>DynamicMochi</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.6.2</Version>
    <ApplicationIcon>Assets\mochi.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- interface strings: plain embedded resources (no satellite assemblies, so the single exe has them) -->
    <EmbeddedResource Update="Strings.ru.resx" WithCulture="false" LogicalName="DynamicMochi.Strings_ru.resources" />
    <EmbeddedResource Update="Strings.en.resx" WithCulture="false" LogicalName="DynamicMochi.Strings_en.resources" />
    <Content Include="Assets\mochi.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Fonts\LICENSES\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
