<Window x:Class="DynamicMochi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Mochi"
        Width="900" Height="640" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource FgBrush}"
        Background="{DynamicResource WindowBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Side menu ===== -->
        <Grid Margin="16,20,12,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="8,0,0,18">
                <Border Width="26" Height="12" CornerRadius="6" Background="Black" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource FaintBrush}" BorderThickness="0.5">
                    <Ellipse Width="5" Height="5" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                </Border>
                <TextBlock Text="Dynamic Mochi" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="NavPanel" Grid.Row="1"/>
            <StackPanel Grid.Row="2">
                <TextBlock x:Name="SavedHint" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="10,0,0,4"/>
                <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="10,0,0,8"
                           MouseLeftButtonUp="Version_Click" Background="Transparent"/>
                <Button Style="{StaticResource FlatButton}" Height="36" Padding="10,0" Click="Quit_Click" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" FontSize="14" Foreground="#FFFF453A" Margin="0,0,10,0"/>
                        <TextBlock x:Name="QuitText" FontSize="13" Foreground="#FFFF453A" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="24,20,40,8">
                <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Height="38" TextChanged="Search_TextChanged"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource FaintBrush}"
                           HorizontalAlignment="Right" Margin="0,0,14,0" IsHitTestVisible="False"/>
            </Grid>
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Style="{StaticResource ThinScroll}" Margin="24,0,24,0" ScrollChanged="ContentScroll_ScrollChanged">
                <StackPanel x:Name="ContentPanel" Margin="0,12,8,24"/>
            </ScrollViewer>
        </Grid>

        <!-- ===== Add place dialog ===== -->
        <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Opacity="0">
            <Border Background="#73000000" MouseLeftButtonDown="DialogDim_Click"/>
            <Border x:Name="DialogCard" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="16" Padding="20"
                    Background="{DynamicResource MenuBrush}" RenderTransformOrigin="0.5,0.5" PreviewKeyDown="Dialog_PreviewKeyDown">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DialogScale"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock x:Name="DialogTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE711;" HorizontalAlignment="Right" Click="DialogClose_Click"/>
                    </Grid>
                    <TextBlock x:Name="DialogSubtitle" FontSize="12" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="0,-6,0,10" Visibility="Collapsed"/>
                    <Grid>
                        <TextBox x:Name="PlaceBox" Style="{StaticResource Field}" Height="36" 
                                 TextChanged="PlaceBox_TextChanged" PreviewKeyDown="PlaceBox_PreviewKeyDown"/>
                        <Ellipse x:Name="PlaceSpinner" Width="14" Height="14" HorizontalAlignment="Right" Margin="0,0,12,0" StrokeThickness="2"
                                 Stroke="{DynamicResource SubBrush}" StrokeDashArray="3 2" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="PlaceSpin"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <StackPanel x:Name="PlaceResults" Margin="0,8,0,0"/>
                    <TextBlock x:Name="PlaceHint" FontSize="12" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed"/>
                    <Button x:Name="LocateRow" Style="{StaticResource FlatButton}" Height="38" Margin="0,8,0,0" Padding="10,0" Click="Locate_Click" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81D;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource FgBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource T.dlg.locate}" FontSize="13" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenLocationSettings" Style="{StaticResource FlatButton}" Height="32" FontSize="12" Padding="10,0" HorizontalAlignment="Left"
                            Foreground="{DynamicResource SubBrush}" Content="{DynamicResource T.dlg.locsettings}" Click="LocationSettings_Click" Visibility="Collapsed"/>
                    <StackPanel x:Name="DistrictButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" Visibility="Collapsed">
                        <Button Style="{StaticResource FlatButton}" Height="30" FontSize="12" Foreground="{DynamicResource SubBrush}" Content="{DynamicResource T.dlg.skip}"
                                Padding="12,0" Margin="0,0,6,0" Click="DistrictSkip_Click"/>
                        <Button Style="{StaticResource AccentButton}" FontSize="12" Content="{DynamicResource T.dlg.done}" Click="DistrictDone_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
