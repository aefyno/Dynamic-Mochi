<Window x:Class="DynamicMochi.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicMochi"
        Title="Dynamic Mochi"
        Width="560" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <local:HeightToRadiusConverter x:Key="HeightToRadius"/>

        <!-- Theme brushes, replaced at runtime -->
        <SolidColorBrush x:Key="BgBrush" Color="Black"/>
        <SolidColorBrush x:Key="FgBrush" Color="White"/>
        <SolidColorBrush x:Key="SubBrush" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="White"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF"/>

        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <!-- Toggle switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11"
                                    Background="{DynamicResource HoverBrush}">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" Margin="3,0"
                                         HorizontalAlignment="Left"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF34C759"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">

            <!-- Capsule -->
            <Border x:Name="Capsule" Width="230" Height="38"
                    Background="{DynamicResource BgBrush}"
                    CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource HeightToRadius}}"
                    MouseEnter="Capsule_MouseEnter" MouseLeave="Capsule_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <Grid ClipToBounds="True">

                    <!-- Collapsed: cover, title, equalizer (clock when idle) -->
                    <Grid x:Name="CollapsedView" Margin="8,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="MiniArtBox" Width="24" Height="24" CornerRadius="7" VerticalAlignment="Center"
                                Background="{DynamicResource HoverBrush}">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,24,24" RadiusX="7" RadiusY="7"/>
                            </Border.Clip>
                            <Image x:Name="MiniArt" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock x:Name="MiniTitle" Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel x:Name="EqBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle x:Name="Bar0" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}"/>
                            <Rectangle x:Name="Bar1" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}"/>
                            <Rectangle x:Name="Bar2" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}"/>
                            <Rectangle x:Name="Bar3" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="MiniClock" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
                    </Grid>

                    <!-- Expanded -->
                    <Grid x:Name="ExpandedView" Margin="18,10,18,16" Opacity="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tabs -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="TabHome" Style="{StaticResource IconButton}" Content="&#xE80F;" ToolTip="Главная" Click="Tab_Click" Tag="home"/>
                            <Button x:Name="TabMusic" Style="{StaticResource IconButton}" Content="&#xE8D6;" ToolTip="Музыка" Click="Tab_Click" Tag="music"/>
                            <Button x:Name="TabSettings" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Настройки" Click="Tab_Click" Tag="settings"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,10,0,0">

                            <!-- Home -->
                            <Grid x:Name="HomePage">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="BigClock" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="44"
                                               FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
                                    <TextBlock x:Name="DateText" FontSize="13" Foreground="{DynamicResource SubBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="190">
                                    <TextBlock x:Name="HomeTitle" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                                    <TextBlock x:Name="HomeArtist" FontSize="11.5" Foreground="{DynamicResource SubBrush}"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                                    <Button x:Name="HomePlay" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                            FontSize="18" Content="&#xE768;" Click="PlayPause_Click" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Music -->
                            <Grid x:Name="MusicPage" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="96" Height="96" CornerRadius="16" Background="{DynamicResource HoverBrush}" VerticalAlignment="Center">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,96,96" RadiusX="16" RadiusY="16"/>
                                    </Border.Clip>
                                    <Image x:Name="BigArt" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="MusicTitle" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"
                                               TextTrimming="CharacterEllipsis" Text="Ничего не играет"/>
                                    <TextBlock x:Name="MusicArtist" FontSize="12.5" Foreground="{DynamicResource SubBrush}"
                                               TextTrimming="CharacterEllipsis" Text="Включи музыку в любом плеере"/>
                                    <Grid x:Name="ProgressTrack" Height="16" Margin="0,10,0,0" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="Progress_MouseDown">
                                        <Border Height="4" CornerRadius="2" Background="{DynamicResource HoverBrush}" VerticalAlignment="Center"/>
                                        <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Width="0" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock x:Name="TimeLeft" FontSize="10.5" Foreground="{DynamicResource SubBrush}" Text="0:00"/>
                                        <TextBlock x:Name="TimeRight" FontSize="10.5" Foreground="{DynamicResource SubBrush}" Text="-0:00" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Button Style="{StaticResource IconButton}" FontSize="16" Content="&#xE892;" Click="Previous_Click"/>
                                        <Button x:Name="MusicPlay" Style="{StaticResource IconButton}" FontSize="22" Content="&#xE768;" Click="PlayPause_Click" Margin="10,0"/>
                                        <Button Style="{StaticResource IconButton}" FontSize="16" Content="&#xE893;" Click="Next_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Settings -->
                            <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
                                <TextBlock Text="Тема" FontSize="11.5" Foreground="{DynamicResource SubBrush}" Margin="0,0,0,6"/>
                                <WrapPanel x:Name="ThemePanel" Margin="0,0,0,10"/>
                                <CheckBox x:Name="LyricsSwitch" Style="{StaticResource Switch}" Margin="0,0,0,8"
                                          Checked="LyricsSwitch_Changed" Unchecked="LyricsSwitch_Changed">
                                    <TextBlock Text="Текст песни под островом" FontSize="13" Foreground="{DynamicResource FgBrush}"/>
                                </CheckBox>
                                <CheckBox x:Name="AutoStartSwitch" Style="{StaticResource Switch}" Margin="0,0,0,10"
                                          Checked="AutoStartSwitch_Changed" Unchecked="AutoStartSwitch_Changed">
                                    <TextBlock Text="Запускать вместе с Windows" FontSize="13" Foreground="{DynamicResource FgBrush}"/>
                                </CheckBox>
                                <Button Style="{StaticResource TextButton}" Content="Выйти" HorizontalAlignment="Right"
                                        Foreground="#FFFF453A" Click="Quit_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Lyric line below the capsule -->
            <Border x:Name="LyricsStrip" Margin="0,6,0,0" Height="30" MinWidth="230" MaxWidth="520" Padding="16,0"
                    HorizontalAlignment="Center" CornerRadius="15" Background="{DynamicResource BgBrush}"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <TextBlock x:Name="LyricText" VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgBrush}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="LyricShift"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse x:Name="Dot0" Width="6" Height="6" Margin="3,0" Fill="{DynamicResource FgBrush}"/>
                        <Ellipse x:Name="Dot1" Width="6" Height="6" Margin="3,0" Fill="{DynamicResource FgBrush}"/>
                        <Ellipse x:Name="Dot2" Width="6" Height="6" Margin="3,0" Fill="{DynamicResource FgBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
