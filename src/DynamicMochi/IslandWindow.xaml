<Window x:Class="DynamicMochi.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicMochi"
        xmlns:controls="clr-namespace:DynamicMochi.Controls"
        Title="Dynamic Mochi"
        Width="700" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <local:HeightToRadiusConverter x:Key="HeightToRadius"/>

        <!-- Theme brushes. Code replaces them on every theme change (never mutates them),
             so everything must reference them with DynamicResource / SetResourceReference. -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#121214"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1E1E22"/>
        <SolidColorBrush x:Key="FgBrush" Color="White"/>
        <SolidColorBrush x:Key="SubBrush" Color="#9EFFFFFF"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#61FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="White"/>
        <SolidColorBrush x:Key="AccentFgBrush" Color="Black"/>
        <SolidColorBrush x:Key="BorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleOffBrush" Color="#3A3A3C"/>
        <SolidColorBrush x:Key="EqBrush" Color="#30D158"/>

        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- Themed tooltip -->
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Placement" Value="Bottom"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="10,5" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" Foreground="{DynamicResource FgBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon button: hover = surface + scale 1.06, press = scale 0.94 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.06" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.06" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.94" Duration="0:0:0.09"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.94" Duration="0:0:0.09"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.06" Duration="0:0:0.09"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.06" Duration="0:0:0.09"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tab button: 40×30, icon 18, no hover background (the sliding pill marks the active tab) -->
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource SubBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular play button filled with the accent colour -->
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain clickable area with a hover plate (rows, text buttons) -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings row: whole row toggles the switch -->
        <Style x:Key="SettingRow" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <!-- Filled plate button: "+ Событие", "Определить автоматически" -->
        <Style x:Key="PlateButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Accent filled button: "Сохранить" -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small chip: reminder options, °C/°F, week start. Background set from code. -->
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text field: surface plate, accent ring when focused, placeholder from Tag -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource FgBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1.5" BorderBrush="Transparent">
                            <Grid Margin="10,0">
                                <TextBlock x:Name="Ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource FaintBrush}" FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin scroll bar: 4 px, Faint, shown only while scrolling (opacity driven from code) -->
        <Style x:Key="ThinBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="2" Background="{DynamicResource FaintBrush}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThinScroll" TargetType="ScrollViewer">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter Margin="0,0,8,0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource ThinBar}" HorizontalAlignment="Right"
                                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme card 100×64: ring (BorderBrush) set from code -->
        <Style x:Key="ThemeCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">

            <!-- Root scale: launch / exit / hover anticipation -->
            <Grid x:Name="CapsuleRoot" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="RootScale" ScaleX="0" ScaleY="0"/>
                </Grid.RenderTransform>

                <!-- The only shadow / glow: on a container without a background, so it follows the rounded capsule -->
                <Border x:Name="GlowHost">
                    <Border.Effect>
                        <DropShadowEffect x:Name="GlowEffect" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black"/>
                    </Border.Effect>
                    <Border x:Name="Capsule" Width="260" Height="52"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource HeightToRadius}}"
                            MouseEnter="Capsule_MouseEnter" MouseLeave="Capsule_MouseLeave" SizeChanged="Capsule_SizeChanged">
                        <Border.Background>
                            <LinearGradientBrush x:Name="BgBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop x:Name="BgTopStop" Color="Black" Offset="0"/>
                                <GradientStop x:Name="BgMidStop" Color="Black" Offset="0.5"/>
                                <GradientStop x:Name="BgEndStop" Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <!-- Everything inside is clipped to the rounded shape (Clip updated on every size change) -->
                        <Grid x:Name="CapsuleContent">
                            <!-- Colour blob: artwork (OLED / white) or weather on the weather tab -->
                            <Rectangle x:Name="TintRect" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <RadialGradientBrush GradientOrigin="0.85,0.05" Center="0.85,0.05" RadiusX="0.7" RadiusY="1.1">
                                        <GradientStop x:Name="TintStop" Color="Transparent" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- ===== Collapsed ===== -->
                            <Grid x:Name="CollapsedView">
                                <!-- playing / paused -->
                                <Grid x:Name="PlayingRow" Margin="8,0,18,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="MiniArtBox" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceBrush}">
                                        <Border.Clip>
                                            <RectangleGeometry Rect="0,0,36,36" RadiusX="10" RadiusY="10"/>
                                        </Border.Clip>
                                        <Grid>
                                            <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="15"
                                                       Foreground="{DynamicResource SubBrush}" HorizontalAlignment="Center"/>
                                            <Image x:Name="MiniArt" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <controls:MarqueeText x:Name="MiniTitle" Grid.Column="1" Margin="12,0" FontSize="14" FontWeight="SemiBold"/>
                                    <StackPanel x:Name="EqBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="18">
                                        <Rectangle x:Name="Bar0" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0" VerticalAlignment="Center" Fill="{DynamicResource EqBrush}"/>
                                        <Rectangle x:Name="Bar1" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0" VerticalAlignment="Center" Fill="{DynamicResource EqBrush}"/>
                                        <Rectangle x:Name="Bar2" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0" VerticalAlignment="Center" Fill="{DynamicResource EqBrush}"/>
                                        <Rectangle x:Name="Bar3" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" Fill="{DynamicResource EqBrush}"/>
                                    </StackPanel>
                                    <Rectangle Grid.Column="3" Width="1" Height="18" Margin="12,0" Fill="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MiniClock" Grid.Column="4" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FgBrush}"/>
                                </Grid>

                                <!-- idle: big clock · date · weather -->
                                <StackPanel x:Name="IdleRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="IdleClock" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="IdleDate" FontSize="13" Foreground="{DynamicResource SubBrush}" VerticalAlignment="Center" Margin="10,1,0,0"/>
                                    <StackPanel x:Name="IdleWeather" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,1,0,0" Visibility="Collapsed">
                                        <controls:WeatherIcon x:Name="IdleWeatherIcon" Width="16" Height="16" Foreground="{DynamicResource FgBrush}"/>
                                        <TextBlock x:Name="IdleTemp" FontSize="13" Foreground="{DynamicResource FgBrush}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- live activity: calendar reminder -->
                                <Grid x:Name="ActivityRow" Margin="20,0,20,0" Visibility="Collapsed" Opacity="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="ActivityDot" Width="10" Height="10" VerticalAlignment="Center" Fill="#0A84FF"/>
                                    <controls:MarqueeText x:Name="ActivityTitle" Grid.Column="1" Margin="12,0" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ActivityWhen" Grid.Column="2" FontSize="13" Foreground="{DynamicResource SubBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>

                            <!-- ===== Expanded ===== -->
                            <Grid x:Name="ExpandedView" Margin="16,12,16,16" Opacity="0" Visibility="Collapsed">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="ExpandedShift"/>
                                </Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Tab bar with a sliding pill -->
                                <Grid Height="30">
                                    <Grid HorizontalAlignment="Center" Width="200">
                                        <Border x:Name="TabPill" Width="40" Height="30" CornerRadius="10" HorizontalAlignment="Left"
                                                Background="{DynamicResource SurfaceBrush}">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="TabPillShift"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="TabHome" Style="{StaticResource TabButton}" Content="&#xE80F;" ToolTip="Главная" Click="Tab_Click" Tag="home"/>
                                            <Button x:Name="TabMusic" Style="{StaticResource TabButton}" Content="&#xE8D6;" ToolTip="Музыка" Click="Tab_Click" Tag="music"/>
                                            <Button x:Name="TabCalendar" Style="{StaticResource TabButton}" Content="&#xE787;" ToolTip="Календарь" Click="Tab_Click" Tag="calendar"/>
                                            <Button x:Name="TabWeather" Style="{StaticResource TabButton}" ToolTip="Погода" Click="Tab_Click" Tag="weather">
                                                <controls:WeatherIcon Icon="PartlySun" Mono="True" Width="19" Height="19"/>
                                            </Button>
                                            <Button x:Name="TabSettings" Style="{StaticResource TabButton}" Content="&#xE713;" ToolTip="Настройки" Click="Tab_Click" Tag="settings"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="SmallClock" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FaintBrush}"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,12,0,0">

                                    <!-- ===== Home ===== -->
                                    <Grid x:Name="HomePage">
                                        <Grid.RenderTransform>
                                            <TranslateTransform/>
                                        </Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="55*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="BigClock" FontFamily="{StaticResource Display}" FontSize="52" FontWeight="SemiBold"
                                                       Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FgBrush}" Margin="0,-6,0,0"/>
                                            <TextBlock x:Name="DateText" FontSize="13" Foreground="{DynamicResource SubBrush}" Margin="0,2,0,0"/>
                                            <Button x:Name="HomeWeather" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Padding="6,2" Margin="-6,6,0,0"
                                                    Click="HomeWeather_Click" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:WeatherIcon x:Name="HomeWeatherIcon" Width="16" Height="16" Foreground="{DynamicResource FgBrush}"/>
                                                    <TextBlock x:Name="HomeWeatherText" FontSize="13" Foreground="{DynamicResource SubBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="HomeEvent" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Padding="6,2" Margin="-6,2,0,0"
                                                    Click="HomeEvent_Click" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="HomeEventDot" Width="8" Height="8" Fill="#0A84FF" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                                    <TextBlock x:Name="HomeEventText" FontSize="12" Foreground="{DynamicResource SubBrush}" Margin="4,0,0,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock x:Name="HintText" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <Border x:Name="HomeCard" Grid.Column="2" CornerRadius="16" Padding="12" VerticalAlignment="Center"
                                                Background="{DynamicResource SurfaceBrush}">
                                            <Grid>
                                                <Grid x:Name="HomeMusic">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="HomeArtBox" Width="72" Height="72" CornerRadius="12" Cursor="Hand"
                                                            Background="{DynamicResource SurfaceHoverBrush}" MouseLeftButtonUp="HomeArt_Click">
                                                        <Border.Clip>
                                                            <RectangleGeometry Rect="0,0,72,72" RadiusX="12" RadiusY="12"/>
                                                        </Border.Clip>
                                                        <Grid>
                                                            <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="22"
                                                                       Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center"/>
                                                            <Image x:Name="HomeArt" Stretch="UniformToFill"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <controls:MarqueeText x:Name="HomeTitle" FontSize="14" FontWeight="SemiBold" Height="20"/>
                                                        <TextBlock x:Name="HomeArtist" FontSize="12" Foreground="{DynamicResource SubBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <Grid x:Name="HomeProgressTrack" Height="3" Margin="0,8,0,8">
                                                            <Border CornerRadius="1.5" Background="{DynamicResource FaintBrush}" Opacity="0.3"/>
                                                            <Border x:Name="HomeProgress" CornerRadius="1.5" Width="0" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"/>
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Предыдущий" Click="Previous_Click" Margin="0,0,4,0"/>
                                                            <Button x:Name="HomePlay" Style="{StaticResource IconButton}" FontSize="20" Content="&#xE768;" ToolTip="Пауза" Click="PlayPause_Click" Margin="0,0,4,0"/>
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Следующий" Click="Next_Click"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel x:Name="HomeEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Height="72" Visibility="Collapsed">
                                                    <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="24" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,12,0,8"/>
                                                    <TextBlock Text="Включи музыку в любом плеере" FontSize="12" Foreground="{DynamicResource SubBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- ===== Music ===== -->
                                    <Grid x:Name="MusicPage" Visibility="Collapsed" Opacity="0">
                                        <Grid.RenderTransform>
                                            <TranslateTransform/>
                                        </Grid.RenderTransform>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="BigArtBox" Width="136" Height="136" CornerRadius="14" VerticalAlignment="Top"
                                                    Background="{DynamicResource SurfaceBrush}" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="BigArtScale" ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,136,136" RadiusX="14" RadiusY="14"/>
                                                </Border.Clip>
                                                <Grid>
                                                    <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="40"
                                                               Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center"/>
                                                    <Image x:Name="BigArt" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                <controls:MarqueeText x:Name="MusicTitle" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold" Height="24"/>
                                                <TextBlock x:Name="MusicArtist" FontSize="13" Foreground="{DynamicResource SubBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                <StackPanel x:Name="SourceRow" Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="SourceText" FontSize="11" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <Grid x:Name="ProgressTrack" Height="18" Margin="0,8,0,0" Background="Transparent" Cursor="Hand"
                                                      MouseLeftButtonDown="Progress_MouseDown" MouseMove="Progress_MouseMove" MouseLeftButtonUp="Progress_MouseUp"
                                                      MouseEnter="Progress_MouseEnter" MouseLeave="Progress_MouseLeave">
                                                    <Border x:Name="ProgressBg" Height="4" CornerRadius="2" Background="{DynamicResource FaintBrush}" Opacity="0.35" VerticalAlignment="Center"/>
                                                    <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Width="0" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                    <Ellipse x:Name="ProgressThumb" Width="12" Height="12" Fill="{DynamicResource FgBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" Margin="-6,0,0,0"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,0">
                                                    <TextBlock x:Name="TimeLeft" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FaintBrush}" Text="0:00"/>
                                                    <TextBlock x:Name="TimeRight" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FaintBrush}" Text="-0:00"
                                                               HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonUp="TimeRight_Click"/>
                                                </Grid>

                                                <StackPanel x:Name="MusicButtons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                    <Button Style="{StaticResource IconButton}" Width="36" Height="36" FontSize="18" Content="&#xE892;" ToolTip="Предыдущий" Click="Previous_Click"/>
                                                    <Button x:Name="MusicPlay" Style="{StaticResource PlayButton}" Content="&#xE768;" ToolTip="Пауза" Click="PlayPause_Click" Margin="16,0"/>
                                                    <Button Style="{StaticResource IconButton}" Width="36" Height="36" FontSize="18" Content="&#xE893;" ToolTip="Следующий" Click="Next_Click"/>
                                                </StackPanel>

                                                <!-- Volume of the playing app (or the system) -->
                                                <Grid x:Name="VolumeRow" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="14"
                                                            Content="&#xE767;" Click="Mute_Click" ToolTip="Выключить звук"/>
                                                    <Grid x:Name="VolumeTrack" Grid.Column="1" Height="18" Margin="8,0" Background="Transparent" Cursor="Hand"
                                                          MouseLeftButtonDown="Volume_MouseDown" MouseMove="Volume_MouseMove" MouseLeftButtonUp="Volume_MouseUp"
                                                          MouseWheel="Volume_MouseWheel" MouseEnter="Volume_MouseEnter" MouseLeave="Volume_MouseLeave">
                                                        <Border x:Name="VolumeBg" Height="4" CornerRadius="2" Background="{DynamicResource FaintBrush}" Opacity="0.35" VerticalAlignment="Center"/>
                                                        <Border x:Name="VolumeFill" Height="4" CornerRadius="2" Width="0" HorizontalAlignment="Left" Background="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                                        <Ellipse x:Name="VolumeThumb" Width="12" Height="12" Fill="{DynamicResource FgBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" Margin="-6,0,0,0"/>
                                                    </Grid>
                                                    <TextBlock x:Name="VolumeText" Grid.Column="2" FontSize="11" Width="30" TextAlignment="Right" Typography.NumeralAlignment="Tabular"
                                                               Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Lyrics preview: current line + next line -->
                                        <StackPanel x:Name="LyricsPreview" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed" ClipToBounds="True" Height="40">
                                            <TextBlock x:Name="PreviewCurrent" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="PreviewShift"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock x:Name="PreviewNext" FontSize="12" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ===== Calendar ===== -->
                                    <Grid x:Name="CalendarPage" Visibility="Collapsed" Opacity="0">
                                        <Grid.RenderTransform>
                                            <TranslateTransform/>
                                        </Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="45*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- month -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="MonthTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="TodayButton" Style="{StaticResource FlatButton}" FontSize="12" Height="28" Content="Сегодня"
                                                        Foreground="{DynamicResource SubBrush}" Click="Today_Click" Visibility="Collapsed" Margin="0,0,2,0"/>
                                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE76B;" ToolTip="Предыдущий месяц" Click="PrevMonth_Click"/>
                                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE76C;" ToolTip="Следующий месяц" Click="NextMonth_Click"/>
                                            </StackPanel>
                                            <UniformGrid x:Name="WeekdaysRow" Grid.Row="1" Columns="7" Rows="1" Margin="0,4,0,2" Width="224" HorizontalAlignment="Left"/>
                                            <Grid x:Name="MonthHost" Grid.Row="2" ClipToBounds="True" Width="224" Height="168" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  Background="Transparent" MouseWheel="Month_MouseWheel"/>
                                        </Grid>

                                        <!-- day list / event form -->
                                        <Grid Grid.Column="2" ClipToBounds="True">
                                            <Grid x:Name="DayListView">
                                                <Grid.RenderTransform>
                                                    <TranslateTransform x:Name="DayListShift"/>
                                                </Grid.RenderTransform>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="28"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="DayTitle" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                                <ScrollViewer x:Name="DayScroll" Grid.Row="1" Style="{StaticResource ThinScroll}" Margin="0,2,-8,8">
                                                    <StackPanel x:Name="DayEvents"/>
                                                </ScrollViewer>
                                                <StackPanel x:Name="DayEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                                    <TextBlock Text="&#xE787;" Style="{StaticResource Glyph}" FontSize="24" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Нет событий" FontSize="12" Foreground="{DynamicResource SubBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Row="2" Style="{StaticResource PlateButton}" Click="AddEvent_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource FgBrush}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Событие" FontSize="13" Foreground="{DynamicResource FgBrush}"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <ScrollViewer x:Name="EventForm" Style="{StaticResource ThinScroll}" Visibility="Collapsed" Margin="0,0,-8,0"
                                                          PreviewKeyDown="EventForm_PreviewKeyDown">
                                                <ScrollViewer.RenderTransform>
                                                    <TranslateTransform x:Name="EventFormShift"/>
                                                </ScrollViewer.RenderTransform>
                                                <StackPanel>
                                                    <TextBox x:Name="FormTitle" Style="{StaticResource Field}" Tag="Название" MaxLength="80"/>
                                                    <Grid Margin="0,8,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource IconButton}" Width="26" Height="28" FontSize="11" Content="&#xE76B;" Click="FormDatePrev_Click"/>
                                                            <TextBlock x:Name="FormDate" FontSize="13" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                                                                       MinWidth="96" TextAlignment="Center"/>
                                                            <Button Style="{StaticResource IconButton}" Width="26" Height="28" FontSize="11" Content="&#xE76C;" Click="FormDateNext_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,8,0,0">
                                                        <TextBox x:Name="FormTime" Style="{StaticResource Field}" Tag="14:30" Width="76" HorizontalAlignment="Left" MaxLength="5"/>
                                                        <Button x:Name="FormAllDay" Style="{StaticResource Chip}" Content="Весь день" HorizontalAlignment="Right" Margin="0" Height="30"
                                                                Click="FormAllDay_Click"/>
                                                    </Grid>
                                                    <StackPanel x:Name="FormColors" Orientation="Horizontal" Margin="2,12,0,0"/>
                                                    <TextBlock Text="Напомнить" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="0,12,0,6"/>
                                                    <WrapPanel x:Name="FormReminders"/>
                                                    <Grid Margin="0,6,0,4">
                                                        <Button x:Name="FormDelete" Style="{StaticResource FlatButton}" Height="30" Foreground="#FFFF453A" FontSize="12"
                                                                HorizontalAlignment="Left" Content="Удалить" Click="FormDelete_Click" Visibility="Collapsed"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource FlatButton}" Height="30" FontSize="12" Foreground="{DynamicResource SubBrush}"
                                                                    Content="Отмена" Click="FormCancel_Click" Margin="0,0,4,0"/>
                                                            <Button Style="{StaticResource AccentButton}" FontSize="12" Content="Сохранить" Click="FormSave_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>

                                    <!-- ===== Weather ===== -->
                                    <Grid x:Name="WeatherPage" Visibility="Collapsed" Opacity="0">
                                        <Grid.RenderTransform>
                                            <TranslateTransform/>
                                        </Grid.RenderTransform>

                                        <StackPanel x:Name="WeatherEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock Text="&#xE81D;" Style="{StaticResource Glyph}" FontSize="32" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Выбери город, чтобы видеть погоду" FontSize="13" Foreground="{DynamicResource SubBrush}" HorizontalAlignment="Center" Margin="0,12,0,12"/>
                                            <Button Style="{StaticResource AccentButton}" Content="Выбрать" HorizontalAlignment="Center" Click="ChoosePlace_Click"/>
                                        </StackPanel>

                                        <Grid x:Name="WeatherContent">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="26"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Padding="6,0" Margin="-6,0,0,0" Click="ChoosePlace_Click"
                                                    ToolTip="Выбрать место">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE707;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource SubBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="WeatherPlace" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="WeatherUpdated" FontSize="11" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Button x:Name="WeatherRefresh" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE72C;"
                                                        ToolTip="Обновить" Click="WeatherRefresh_Click"/>
                                            </StackPanel>

                                            <!-- now -->
                                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <controls:WeatherIcon x:Name="NowIcon" Width="48" Height="48" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="NowTemp" FontFamily="{StaticResource Display}" FontSize="44" FontWeight="SemiBold"
                                                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FgBrush}" Margin="0,-8,0,-4"/>
                                                    <TextBlock x:Name="NowDesc" FontSize="13" Foreground="{DynamicResource SubBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <controls:WeatherIcon Icon="Thermo" Width="14" Height="14" Foreground="{DynamicResource SubBrush}" Mono="True"/>
                                                        <TextBlock x:Name="NowFeels" FontSize="12" Foreground="{DynamicResource SubBrush}" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <controls:WeatherIcon Icon="Wind" Width="14" Height="14" Foreground="{DynamicResource SubBrush}" Mono="True"/>
                                                        <TextBlock x:Name="NowWind" FontSize="12" Foreground="{DynamicResource SubBrush}" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:WeatherIcon Icon="Drop" Width="14" Height="14" Foreground="{DynamicResource SubBrush}" Mono="True"/>
                                                        <TextBlock x:Name="NowHumidity" FontSize="12" Foreground="{DynamicResource SubBrush}" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <!-- next 12 hours -->
                                            <ScrollViewer x:Name="HourScroll" Grid.Row="2" Margin="0,10,0,0" Focusable="False"
                                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                                          PreviewMouseWheel="HourScroll_MouseWheel">
                                                <StackPanel x:Name="HourPanel" Orientation="Horizontal"/>
                                            </ScrollViewer>

                                            <!-- 7 days -->
                                            <ScrollViewer x:Name="DaysScroll" Grid.Row="3" Style="{StaticResource ThinScroll}" Margin="0,8,-8,0">
                                                <StackPanel x:Name="DaysPanel"/>
                                            </ScrollViewer>

                                            <StackPanel x:Name="PlaceDots" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </Grid>
                                    </Grid>

                                    <!-- ===== Settings ===== -->
                                    <ScrollViewer x:Name="SettingsPage" Style="{StaticResource ThinScroll}" Visibility="Collapsed" Opacity="0" Margin="0,0,-8,0">
                                        <ScrollViewer.RenderTransform>
                                            <TranslateTransform/>
                                        </ScrollViewer.RenderTransform>
                                        <StackPanel>
                                            <TextBlock Text="ВНЕШНИЙ ВИД" Style="{StaticResource SectionHeader}"/>
                                            <UniformGrid x:Name="ThemePanel" Columns="3" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                                            <TextBlock x:Name="WeatherSection" Text="ПОГОДА" Style="{StaticResource SectionHeader}" Margin="0,8,0,8"/>
                                            <StackPanel x:Name="PlacesList" Margin="0,0,0,4"/>
                                            <Grid x:Name="CityRow">
                                                <TextBox x:Name="CityBox" Style="{StaticResource Field}" Tag="Найти город" TextChanged="CityBox_TextChanged"
                                                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                                                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource FaintBrush}"
                                                           HorizontalAlignment="Right" Margin="0,0,12,0" IsHitTestVisible="False"/>
                                                <Ellipse x:Name="CitySpinner" Width="14" Height="14" HorizontalAlignment="Right" Margin="0,0,32,0" StrokeThickness="2"
                                                         Stroke="{DynamicResource SubBrush}" StrokeDashArray="3 2" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                                                         IsHitTestVisible="False">
                                                    <Ellipse.RenderTransform>
                                                        <RotateTransform x:Name="CitySpin"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel x:Name="CityResults" Margin="0,4,0,0"/>
                                            <Grid x:Name="DistrictRow" Margin="0,8,0,0" Visibility="Collapsed">
                                                <TextBox x:Name="DistrictBox" Style="{StaticResource Field}" Tag="Район или улица (необязательно)"
                                                         TextChanged="DistrictBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                                                <Ellipse x:Name="DistrictSpinner" Width="14" Height="14" HorizontalAlignment="Right" Margin="0,0,12,0" StrokeThickness="2"
                                                         Stroke="{DynamicResource SubBrush}" StrokeDashArray="3 2" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                                                         IsHitTestVisible="False">
                                                    <Ellipse.RenderTransform>
                                                        <RotateTransform x:Name="DistrictSpin"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel x:Name="DistrictResults" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="PlaceHint" FontSize="12" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button x:Name="LocateButton" Style="{StaticResource PlateButton}" Click="Locate_Click" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE81D;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource FgBrush}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Определить автоматически" FontSize="13" Foreground="{DynamicResource FgBrush}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="LocationSettingsButton" Style="{StaticResource FlatButton}" Height="32" FontSize="12" Visibility="Collapsed"
                                                        Foreground="{DynamicResource SubBrush}" Content="Открыть параметры" Click="LocationSettings_Click"/>
                                            </WrapPanel>
                                            <Grid Margin="12,10,0,4">
                                                <TextBlock Text="Единицы" FontSize="13" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button x:Name="UnitC" Style="{StaticResource Chip}" Content="°C" Margin="0,0,4,0" Click="UnitC_Click"/>
                                                    <Button x:Name="UnitF" Style="{StaticResource Chip}" Content="°F" Margin="0" Click="UnitF_Click"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="КАЛЕНДАРЬ" Style="{StaticResource SectionHeader}" Margin="0,16,0,8"/>
                                            <Grid Margin="12,0,0,4" Height="32">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE787;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{DynamicResource SubBrush}" Margin="0,0,12,0"/>
                                                    <TextBlock Text="Неделя начинается с" FontSize="13" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button x:Name="WeekMon" Style="{StaticResource Chip}" Content="Пн" Margin="0,0,4,0" Click="WeekMon_Click"/>
                                                    <Button x:Name="WeekSun" Style="{StaticResource Chip}" Content="Вс" Margin="0" Click="WeekSun_Click"/>
                                                </StackPanel>
                                            </Grid>
                                            <Button x:Name="NextEventRow" Style="{StaticResource SettingRow}" Click="NextEventRow_Click">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE823;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{DynamicResource SubBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="Ближайшее событие на Главной" FontSize="13" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border x:Name="NextEventToggle" Width="40" Height="22" CornerRadius="11" HorizontalAlignment="Right">
                                                        <Ellipse x:Name="NextEventKnob" Width="18" Height="18" HorizontalAlignment="Left" Margin="2,0,0,0">
                                                            <Ellipse.RenderTransform>
                                                                <TranslateTransform/>
                                                            </Ellipse.RenderTransform>
                                                        </Ellipse>
                                                    </Border>
                                                </Grid>
                                            </Button>

                                            <TextBlock Text="ПОВЕДЕНИЕ" Style="{StaticResource SectionHeader}" Margin="0,16,0,8"/>
                                            <Button x:Name="LyricsRow" Style="{StaticResource SettingRow}" Click="LyricsRow_Click">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8D2;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{DynamicResource SubBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="Текст песни под островом" FontSize="13" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border x:Name="LyricsToggle" Width="40" Height="22" CornerRadius="11" HorizontalAlignment="Right">
                                                        <Ellipse x:Name="LyricsKnob" Width="18" Height="18" HorizontalAlignment="Left" Margin="2,0,0,0">
                                                            <Ellipse.RenderTransform>
                                                                <TranslateTransform/>
                                                            </Ellipse.RenderTransform>
                                                        </Ellipse>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            <Button x:Name="AutoStartRow" Style="{StaticResource SettingRow}" Click="AutoStartRow_Click">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{DynamicResource SubBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="Запускать вместе с Windows" FontSize="13" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border x:Name="AutoStartToggle" Width="40" Height="22" CornerRadius="11" HorizontalAlignment="Right">
                                                        <Ellipse x:Name="AutoStartKnob" Width="18" Height="18" HorizontalAlignment="Left" Margin="2,0,0,0">
                                                            <Ellipse.RenderTransform>
                                                                <TranslateTransform/>
                                                            </Ellipse.RenderTransform>
                                                        </Ellipse>
                                                    </Border>
                                                </Grid>
                                            </Button>

                                            <Grid Margin="0,12,0,4">
                                                <TextBlock x:Name="VersionText" FontSize="11" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>
                                                <Button x:Name="QuitButton" Style="{StaticResource FlatButton}" Height="30" HorizontalAlignment="Right" Padding="10,0" Click="Quit_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="13" Foreground="#FFFF453A" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Выйти" FontSize="13" Foreground="#FFFF453A" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>
            </Grid>

            <!-- ===== Lyric line below the capsule ===== -->
            <Border x:Name="LyricsStrip" Margin="0,8,0,0" MinHeight="36" MaxWidth="600" Padding="16,8" HorizontalAlignment="Center"
                    CornerRadius="18" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop x:Name="StripTopStop" Color="#E0000000" Offset="0"/>
                        <GradientStop x:Name="StripEndStop" Color="#E0000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect x:Name="StripShadow" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <TextBlock x:Name="LyricText" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="568" Foreground="{DynamicResource FgBrush}"
                               FontSize="15" FontWeight="SemiBold" LineStackingStrategy="BlockLineHeight" LineHeight="20" MaxHeight="40">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="LyricShift"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse x:Name="Dot0" Width="6" Height="6" Margin="3,0" Fill="{DynamicResource SubBrush}"/>
                        <Ellipse x:Name="Dot1" Width="6" Height="6" Margin="3,0" Fill="{DynamicResource SubBrush}"/>
                        <Ellipse x:Name="Dot2" Width="6" Height="6" Margin="3,0" Fill="{DynamicResource SubBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
