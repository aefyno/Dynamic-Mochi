<Window x:Class="DynamicMochi.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicMochi"
        xmlns:controls="clr-namespace:DynamicMochi.Controls"
        Title="Dynamic Mochi"
        Width="620" Height="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <local:HeightToRadiusConverter x:Key="HeightToRadius"/>

        <!-- Theme brushes: replaced by unfrozen brushes in code so theme changes animate -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#16161A"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#22222A"/>
        <SolidColorBrush x:Key="FgBrush" Color="White"/>
        <SolidColorBrush x:Key="SubBrush" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#61FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="White"/>
        <SolidColorBrush x:Key="AccentFgBrush" Color="Black"/>
        <SolidColorBrush x:Key="BorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleOffBrush" Color="#3A3A3C"/>
        <SolidColorBrush x:Key="EqBrush" Color="#30D158"/>
        <SolidColorBrush x:Key="TabPillBrush" Color="#16161A"/>
        <SolidColorBrush x:Key="TabActiveBrush" Color="White"/>
        <SolidColorBrush x:Key="CardFillBrush" Color="#16161A"/>
        <SolidColorBrush x:Key="CardStrokeBrush" Color="#80000000"/>

        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- Themed tooltip -->
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Placement" Value="Bottom"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="10,5" Margin="0,4,0,0"
                                BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" Foreground="{DynamicResource FgBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon button: hover = surface + scale 1.06, press = scale 0.94 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.06" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.06" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.94" Duration="0:0:0.09"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.94" Duration="0:0:0.09"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.06" Duration="0:0:0.09"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.06" Duration="0:0:0.09"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tab button: 40×30, icon 18, no hover background (the moving pill handles the active state) -->
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource SubBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular play button filled with the accent colour -->
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings row: whole row toggles the switch -->
        <Style x:Key="SettingRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme card -->
        <Style x:Key="ThemeCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">

            <!-- Root scale: launch / exit / hover anticipation -->
            <Grid x:Name="CapsuleRoot" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="RootScale" ScaleX="0" ScaleY="0"/>
                </Grid.RenderTransform>

                <!-- Glow (coloured) sits under the capsule -->
                <Border x:Name="GlowHost" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect x:Name="GlowEffect" BlurRadius="18" ShadowDepth="0" Opacity="0" Color="Transparent"/>
                    </Border.Effect>
                    <Border x:Name="Capsule" Width="320" Height="44"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource HeightToRadius}}"
                            MouseEnter="Capsule_MouseEnter" MouseLeave="Capsule_MouseLeave">
                        <Border.Effect>
                            <DropShadowEffect x:Name="ShadowEffect" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <Border.Background>
                            <LinearGradientBrush x:Name="BgBrush" StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="BgTopStop" Color="Black" Offset="0"/>
                                <GradientStop x:Name="BgBottomStop" Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid x:Name="CapsuleContent" ClipToBounds="True">
                            <!-- Colour blob from the artwork (top-right) -->
                            <Rectangle x:Name="TintRect" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <RadialGradientBrush GradientOrigin="0.85,0.05" Center="0.85,0.05" RadiusX="0.7" RadiusY="1.1">
                                        <GradientStop x:Name="TintStop" Color="Transparent" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- ===== Collapsed ===== -->
                            <Grid x:Name="CollapsedView">
                                <!-- playing / paused -->
                                <Grid x:Name="PlayingRow" Margin="8,0,14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="MiniArtBox" Width="30" Height="30" CornerRadius="8" VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceBrush}">
                                        <Border.Clip>
                                            <RectangleGeometry Rect="0,0,30,30" RadiusX="8" RadiusY="8"/>
                                        </Border.Clip>
                                        <Grid>
                                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                       Foreground="{DynamicResource SubBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="MiniArt" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <controls:MarqueeText x:Name="MiniTitle" Grid.Column="1" Margin="10,0" FontSize="13" FontWeight="SemiBold"/>
                                    <StackPanel x:Name="EqBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="16">
                                        <Rectangle x:Name="Bar0" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0" VerticalAlignment="Center" Fill="{DynamicResource EqBrush}"/>
                                        <Rectangle x:Name="Bar1" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0" VerticalAlignment="Center" Fill="{DynamicResource EqBrush}"/>
                                        <Rectangle x:Name="Bar2" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0" VerticalAlignment="Center" Fill="{DynamicResource EqBrush}"/>
                                        <Rectangle x:Name="Bar3" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" Fill="{DynamicResource EqBrush}"/>
                                    </StackPanel>
                                    <Rectangle Grid.Column="3" Width="1" Height="16" Margin="10,0" Fill="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MiniClock" Grid.Column="4" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FgBrush}"/>
                                </Grid>
                                <!-- idle: clock · date -->
                                <StackPanel x:Name="IdleRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed">
                                    <TextBlock x:Name="IdleClock" FontSize="14" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FgBrush}"/>
                                    <TextBlock Text="·" FontSize="14" Margin="8,0" Foreground="{DynamicResource FaintBrush}"/>
                                    <TextBlock x:Name="IdleDate" FontSize="12" Foreground="{DynamicResource SubBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- ===== Expanded ===== -->
                            <Grid x:Name="ExpandedView" Margin="16,12,16,16" Opacity="0" Visibility="Collapsed">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="ExpandedShift"/>
                                </Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Tab bar with a sliding pill -->
                                <Grid Height="30">
                                    <Grid HorizontalAlignment="Center" Width="120">
                                        <Border x:Name="TabPill" Width="40" Height="30" CornerRadius="10" HorizontalAlignment="Left"
                                                Background="{DynamicResource TabPillBrush}">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="TabPillShift"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="TabHome" Style="{StaticResource TabButton}" Content="&#xE80F;" ToolTip="Главная" Click="Tab_Click" Tag="home"/>
                                            <Button x:Name="TabMusic" Style="{StaticResource TabButton}" Content="&#xE8D6;" ToolTip="Музыка" Click="Tab_Click" Tag="music"/>
                                            <Button x:Name="TabSettings" Style="{StaticResource TabButton}" Content="&#xE713;" ToolTip="Настройки" Click="Tab_Click" Tag="settings"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="SmallClock" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FaintBrush}"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,12,0,0">

                                    <!-- ===== Home ===== -->
                                    <Grid x:Name="HomePage">
                                        <Grid.RenderTransform>
                                            <TranslateTransform/>
                                        </Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="55*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="BigClock" FontFamily="{StaticResource Display}" FontSize="52" FontWeight="SemiBold"
                                                       Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FgBrush}" Margin="0,-6,0,0"/>
                                            <TextBlock x:Name="DateText" FontSize="13" Foreground="{DynamicResource SubBrush}" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="HintText" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,12,0,0"/>
                                        </StackPanel>

                                        <Border x:Name="HomeCard" Grid.Column="2" CornerRadius="16" Padding="12" VerticalAlignment="Center"
                                                Background="{DynamicResource CardFillBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid x:Name="HomeMusic">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="HomeArtBox" Width="72" Height="72" CornerRadius="12" Cursor="Hand"
                                                            Background="{DynamicResource SurfaceHoverBrush}" MouseLeftButtonUp="HomeArt_Click">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="Black"/>
                                                        </Border.Effect>
                                                        <Border CornerRadius="12">
                                                            <Border.Clip>
                                                                <RectangleGeometry Rect="0,0,72,72" RadiusX="12" RadiusY="12"/>
                                                            </Border.Clip>
                                                            <Grid>
                                                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="22"
                                                                           Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <Image x:Name="HomeArt" Stretch="UniformToFill"/>
                                                            </Grid>
                                                        </Border>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <controls:MarqueeText x:Name="HomeTitle" FontSize="14" FontWeight="SemiBold" Height="20"/>
                                                        <TextBlock x:Name="HomeArtist" FontSize="12" Foreground="{DynamicResource SubBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <Grid x:Name="HomeProgressTrack" Height="3" Margin="0,8,0,8">
                                                            <Border CornerRadius="1.5" Background="{DynamicResource FaintBrush}" Opacity="0.3"/>
                                                            <Border x:Name="HomeProgress" CornerRadius="1.5" Width="0" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"/>
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Предыдущий" Click="Previous_Click" Margin="0,0,4,0"/>
                                                            <Button x:Name="HomePlay" Style="{StaticResource IconButton}" FontSize="20" Content="&#xE768;" ToolTip="Пауза" Click="PlayPause_Click" Margin="0,0,4,0"/>
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Следующий" Click="Next_Click"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel x:Name="HomeEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Height="72" Visibility="Collapsed">
                                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,12,0,8"/>
                                                    <TextBlock Text="Включи музыку в любом плеере" FontSize="12" Foreground="{DynamicResource SubBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- ===== Music ===== -->
                                    <Grid x:Name="MusicPage" Visibility="Collapsed" Opacity="0">
                                        <Grid.RenderTransform>
                                            <TranslateTransform/>
                                        </Grid.RenderTransform>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="BigArtBox" Width="120" Height="120" CornerRadius="14" VerticalAlignment="Top"
                                                    Background="{DynamicResource SurfaceBrush}" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="BigArtScale" ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                                                </Border.Effect>
                                                <Border CornerRadius="14">
                                                    <Border.Clip>
                                                        <RectangleGeometry Rect="0,0,120,120" RadiusX="14" RadiusY="14"/>
                                                    </Border.Clip>
                                                    <Grid>
                                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="40"
                                                                   Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image x:Name="BigArt" Stretch="UniformToFill"/>
                                                    </Grid>
                                                </Border>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                <controls:MarqueeText x:Name="MusicTitle" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold" Height="24"/>
                                                <TextBlock x:Name="MusicArtist" FontSize="13" Foreground="{DynamicResource SubBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                <StackPanel x:Name="SourceRow" Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="SourceText" FontSize="11" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <Grid x:Name="ProgressTrack" Height="18" Margin="0,12,0,0" Background="Transparent" Cursor="Hand"
                                                      MouseLeftButtonDown="Progress_MouseDown" MouseMove="Progress_MouseMove" MouseLeftButtonUp="Progress_MouseUp"
                                                      MouseEnter="Progress_MouseEnter" MouseLeave="Progress_MouseLeave">
                                                    <Border x:Name="ProgressBg" Height="4" CornerRadius="2" Background="{DynamicResource FaintBrush}" Opacity="0.3" VerticalAlignment="Center"/>
                                                    <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Width="0" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                    <Ellipse x:Name="ProgressThumb" Width="12" Height="12" Fill="{DynamicResource FgBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" Margin="-6,0,0,0">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.5" Color="Black"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                                <Grid Margin="0,2,0,0">
                                                    <TextBlock x:Name="TimeLeft" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FaintBrush}" Text="0:00"/>
                                                    <TextBlock x:Name="TimeRight" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FaintBrush}" Text="-0:00"
                                                               HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonUp="TimeRight_Click"/>
                                                </Grid>

                                                <StackPanel x:Name="MusicButtons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                    <Button Style="{StaticResource IconButton}" Width="36" Height="36" FontSize="18" Content="&#xE892;" ToolTip="Предыдущий" Click="Previous_Click"/>
                                                    <Button x:Name="MusicPlay" Style="{StaticResource PlayButton}" Content="&#xE768;" ToolTip="Пауза" Click="PlayPause_Click" Margin="16,0">
                                                        <Button.RenderTransform>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                        </Button.RenderTransform>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Width="36" Height="36" FontSize="18" Content="&#xE893;" ToolTip="Следующий" Click="Next_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Lyrics preview: current line + next line -->
                                        <StackPanel x:Name="LyricsPreview" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed" ClipToBounds="True" Height="40">
                                            <TextBlock x:Name="PreviewCurrent" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="PreviewShift"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock x:Name="PreviewNext" FontSize="12" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ===== Settings ===== -->
                                    <StackPanel x:Name="SettingsPage" Visibility="Collapsed" Opacity="0">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform/>
                                        </StackPanel.RenderTransform>
                                        <TextBlock Text="ВНЕШНИЙ ВИД" Style="{StaticResource SectionHeader}"/>
                                        <UniformGrid x:Name="ThemePanel" Rows="1" Margin="0,0,-8,16"/>

                                        <TextBlock Text="ПОВЕДЕНИЕ" Style="{StaticResource SectionHeader}"/>
                                        <Button x:Name="LyricsRow" Style="{StaticResource SettingRow}" Click="LyricsRow_Click">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8D2;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource SubBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <TextBlock Text="Текст песни под островом" FontSize="13" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border x:Name="LyricsToggle" Width="40" Height="22" CornerRadius="11" HorizontalAlignment="Right" Background="{DynamicResource ToggleOffBrush}">
                                                    <Ellipse x:Name="LyricsKnob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                                        <Ellipse.RenderTransform>
                                                            <TranslateTransform/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="AutoStartRow" Style="{StaticResource SettingRow}" Click="AutoStartRow_Click">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource SubBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <TextBlock Text="Запускать вместе с Windows" FontSize="13" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border x:Name="AutoStartToggle" Width="40" Height="22" CornerRadius="11" HorizontalAlignment="Right" Background="{DynamicResource ToggleOffBrush}">
                                                    <Ellipse x:Name="AutoStartKnob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                                        <Ellipse.RenderTransform>
                                                            <TranslateTransform/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <Grid Margin="0,12,0,0">
                                            <TextBlock Text="Dynamic Mochi 0.1.0" FontSize="11" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>
                                            <Button x:Name="QuitButton" Style="{StaticResource IconButton}" Width="Auto" Height="30" HorizontalAlignment="Right"
                                                    FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#FFFF453A" Click="Quit_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="#FFFF453A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <TextBlock Text="Выйти" FontSize="13" Foreground="#FFFF453A" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#1FFF453A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>
            </Grid>

            <!-- ===== Lyric line below the capsule ===== -->
            <Border x:Name="LyricsStrip" Margin="0,8,0,0" MinHeight="36" MaxWidth="560" Padding="16,8" HorizontalAlignment="Center"
                    CornerRadius="18" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="StripTopStop" Color="#D9000000" Offset="0"/>
                        <GradientStop x:Name="StripBottomStop" Color="#D9000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <TextBlock x:Name="LyricText" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="528" Foreground="{DynamicResource FgBrush}"
                               FontSize="15" FontWeight="SemiBold" LineStackingStrategy="BlockLineHeight" LineHeight="20" MaxHeight="40">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="LyricShift"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse x:Name="Dot0" Width="6" Height="6" Margin="3,0" Fill="{DynamicResource SubBrush}"/>
                        <Ellipse x:Name="Dot1" Width="6" Height="6" Margin="3,0" Fill="{DynamicResource SubBrush}"/>
                        <Ellipse x:Name="Dot2" Width="6" Height="6" Margin="3,0" Fill="{DynamicResource SubBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
